# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/revenue_data_reliability

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# LLM
GROQ_API_KEY=

# GitHub Actions trigger
GH_TOKEN=

# Webhook verification
WEBHOOK_TOKEN=dev-webhook-token

# App
PERSONA_COOKIE_NAME=persona
APP_ENV=dev

# OTEL (all optional; telemetry exports into Postgres only)
OTEL_SERVICE_NAME=rlp-platform
OTEL_METRIC_INTERVAL_SECONDS=60
OTEL_RETENTION_DAYS=30

# Scheduler + Controller verification
CONTROLLER_INTERVAL_MINUTES=15
CONTROLLER_STALE_HOURS=24