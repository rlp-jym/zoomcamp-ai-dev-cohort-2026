# Model credentials for the on-call headless agent (opencode run).
# NEVER commit this file (see .gitignore). Copy from .env.example:
#   copy .env.example .env   (PowerShell: Copy-Item .env.example .env)
# Then fill in ONE provider key. opencode picks it up automatically.
# Example: ANTHROPIC_API_KEY=sk-ant-...
# Any provider opencode supports works; see `opencode models` on the host.
ANTHROPIC_API_KEY=
# Optional: pin the model for incident runs (default: opencode default).
# OPENCODE_MODEL=anthropic/claude-sonnet-4-5
